# UniSafe Dashboard - environment configuration
#
# Copy to `.env` for local development. For deployment, set these as build
# environment variables in your host (Vercel / Netlify) instead, because Vite
# inlines VITE_* values at build time.
#
# Do NOT include an /api suffix - the API client adds it automatically.

# Development
VITE_API_URL=http://localhost:3001

# Production: the deployed backend origin, e.g. https://unisafe-api.onrender.com
# This single value is used for REST calls and for the Socket.IO connection.
# VITE_API_URL=https://YOUR_BACKEND_HOST

# Note: there is no VITE_FIREBASE_* configuration any more. The dashboard reads
# and writes exclusively through the backend REST API and Socket.IO transport.