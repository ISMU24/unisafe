# Root .env — used by docker-compose.yml
# Copy to .env and fill in real values. Never commit .env.
#
# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=unisafe_dev

# ── Authentication ────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-random-hex-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-random-hex-characters

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# Must include the deployed dashboard URL.
CLIENT_ORIGINS=https://dashboard.example.com

# ── AI Policy Search (optional) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
