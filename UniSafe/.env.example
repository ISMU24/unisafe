# UniSafe (Expo) — Environment Variables
#
# These are read at BUILD TIME and embedded in the app bundle, so they are
# visible to anyone who unzips the APK. Never put a secret here — the app only
# needs the API's public URL.
#
# Copy this file to `.env` for local development, or set the variable in your
# EAS build profile. See DEPLOYMENT.md.
#
# PRODUCTION: replace with your deployed API, e.g.
#   EXPO_PUBLIC_API_URL=https://unisafe-api.onrender.com
# The URL must be HTTPS. Android blocks cleartext HTTP to non-local hosts, so a
# plain http:// host fails on a real device even though it works on localhost.
EXPO_PUBLIC_API_URL=http://192.168.92.205:3001

# For an Android emulator, use the emulator's alias for the host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
#
# For a physical device on the same Wi-Fi, use your machine's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:3001