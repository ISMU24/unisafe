{
  "name": "unisafe-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "start": "node -r dotenv/config index.js",
    "dev": "node --watch -r dotenv/config index.js",
    "db:init": "node -r dotenv/config scripts/init-db.js",
    "db:seed": "node -r dotenv/config scripts/seed-db.js",
    "db:reset-reports": "node scripts/reset-reports.mjs",
    "test": "vitest run --config vitest.config.js",
    "e2e": "node scripts/e2e-verify.mjs"
  }
