# UniSafe Server — Production environment template
#
# Copy to `.env` and fill in real values, or set these variables directly in your
# hosting provider's dashboard. Never commit the filled-in file.
#
# ── Runtime ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database ────────────────────────────────────────────────────────────────────
# Use EITHER DATABASE_URL or the individual DB_* values.
# Most managed providers (Render, Neon, Supabase, Railway, Azure) require TLS;
# TLS is enabled automatically for known provider hostnames. Set DB_SSL=true to
# force it on for any other host, or DB_SSL=false to force it off.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/unisafe
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=unisafe
# DB_USER=unisafe
# DB_PASSWORD=change-me

# DB_SSL=true
# Verify the provider's certificate. Leave false when the provider presents a
# chain Node does not trust; set true once you have supplied a CA below.
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=/path/to/ca-certificate.pem

# Connection pool tuning for small or free-tier instances.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=15000
# DB_IDLE_TIMEOUT_MS=30000

# ── Authentication ──────────────────────────────────────────────────────────────
# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing either value signs every user out.
JWT_ACCESS_SECRET=replace-with-64-random-hex-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-random-hex-characters
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ── CORS / realtime origins ─────────────────────────────────────────────────────
# Comma-separated list of exact origins allowed to call the API and open
# Socket.IO connections. This must include your deployed dashboard origin,
# e.g. https://your-dashboard.onrender.com
CLIENT_ORIGINS=https://your-dashboard.example.com
ALLOWED_ORIGINS=

# ── Rate limiting ───────────────────────────────────────────────────────────────
# Defaults: 10 failed logins per 15 minutes per IP+email, 5000 API requests per
# 15 minutes per IP. Raise API if the whole campus shares one public address.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
# LOGIN_RATE_LIMIT_MAX_REQUESTS=10
# API_RATE_LIMIT_MAX_REQUESTS=5000
# UPLOAD_RATE_LIMIT_MAX_REQUESTS=60
# AI_RATE_LIMIT_MAX_REQUESTS=30

# ── Initial admin bootstrap ─────────────────────────────────────────────────────
# Only used when no ADMIN account exists yet. Leave both blank and run
# `npm run db:seed`, which generates and prints credentials instead.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Seed data credentials (used only by `npm run db:seed`) ──────────────────────
# Anything left blank is generated randomly and printed at the end of the run.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ICT_EMAIL=
SEED_ICT_PASSWORD=
SEED_SECURITY_EMAIL=
SEED_SECURITY_PASSWORD=
SEED_MEDICAL_EMAIL=
SEED_MEDICAL_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_STUDENT1_EMAIL=
SEED_STUDENT1_PASSWORD=
SEED_STUDENT2_EMAIL=
SEED_STUDENT2_PASSWORD=
SEED_STUDENT3_EMAIL=
SEED_STUDENT3_PASSWORD=

# ── Policy Q&A (optional) ───────────────────────────────────────────────────────
# Leave blank to run the platform without AI features. Incidents, SOS, alerts and
# the dashboard all work without these; only /api/policy-search is disabled and
# GET /api/health reports rag.configured=false.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Set to 1 to print full stack traces from the db:seed script.
DEBUG=0