# UniSafe Server — Environment Variables
# Copy this file to .env and fill in your keys.

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL is mandatory for production/demo and the default for development.
# Missing configuration fails startup; PostgreSQL errors never switch to SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/unisafe?sslmode=require
#
# SQLite is only for explicit local development and automated tests.
# Clear PostgreSQL connection settings and opt in with ALLOW_SQLITE_FALLBACK=true,
# or run npm run start:sqlite (refused in production).
ALLOW_SQLITE_FALLBACK=false
# The default file is server/data/unisafe.db; keep it to retain existing data.
# Optional override (relative paths resolve from the server working directory):
# SQLITE_PATH=./data/unisafe.db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=unisafe
# DB_USER=postgres
# DB_PASSWORD=postgres

# ── RAG Policy Search (server-side only — never expose to clients) ────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here

# ── Firebase Admin (for legacy seeds / one-time data imports) ─────────────────
# Path to your Firebase service account JSON key file.
# Download from: https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk
FIREBASE_SERVICE_ACCOUNT_KEY=./service-account-key.json

# ── Authentication (JWT) ──────────────────────────────────────────────────────
# Generate secure secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Token expiry (in seconds)
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ── Initial Admin (generated on first server boot) ─────────────────────────────
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS — comma-separated list of allowed origins (for production) ───────────
# ALLOWED_ORIGINS=https://your-dashboard.example.com,https://api.example.com
CLIENT_ORIGINS=http://localhost:5173

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
